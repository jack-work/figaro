{
 "version": 1,
 "provider": {
  "rules": [
   {
    "when": "think and run",
    "rounds": [
     {
      "thinking": "I should check the directory first.",
      "text": "Looking now.",
      "tool": {
       "name": "bash",
       "input": {
        "command": "echo parity-ok"
       }
      },
      "pace": 0.3,
      "hold": 2
     },
     {
      "text": "Done: parity-ok seen.",
      "pace": 0.05
     }
    ]
   },
   {
    "when": "steered work",
    "rounds": [
     {
      "text": "Starting the long step.",
      "tool": {
       "name": "bash",
       "input": {
        "command": "sleep 8; echo woke"
       }
      }
     },
     {
      "text": "Steered work done."
     }
    ]
   },
   {
    "when": "steer ack",
    "rounds": [
     {
      "text": "Steer acknowledged."
     }
    ]
   },
   {
    "when": "slow work",
    "rounds": [
     {
      "hold": 3,
      "text": "Slow work finished."
     }
    ]
   },
   {
    "when": "doomed",
    "fail": {
     "status": 400,
     "times": 1
    },
    "rounds": [
     {
      "text": "Second try worked."
     }
    ]
   }
  ],
  "default": {
   "text": "Ecco fatto."
  }
 },
 "scenarios": [
  {
   "id": "attend",
   "title": "Attend a fresh figaro",
   "slice": "messages.attend",
   "setup": {
    "aria": "main",
    "seed": []
   },
   "steps": [
    {
     "id": "attended",
     "do": {
      "attend": "main"
     },
     "expect": {
      "turns": [],
      "state": {
       "system.provider": "anthropic"
      },
      "screen": {
       "glyphs": []
      }
     }
    }
   ]
  },
  {
   "id": "send",
   "title": "Send one prompt, get one reply",
   "slice": "messages.show-everything",
   "setup": {
    "aria": "main",
    "seed": []
   },
   "steps": [
    {
     "id": "attended",
     "do": {
      "attend": "main"
     },
     "expect": {
      "turns": []
     }
    },
    {
     "id": "sent",
     "do": {
      "send": "hello parity"
     },
     "expect": {
      "turns_started": true
     }
    },
    {
     "id": "replied",
     "do": {
      "wait": "idle"
     },
     "expect": {
      "running": false,
      "turns": [
       {
        "turn": 1,
        "inquiry": "hello parity",
        "nodes": [
         {
          "type": "prose",
          "role": "output",
          "text_contains": "Ecco fatto."
         }
        ]
       }
      ],
      "screen": {
       "contains": [
        "hello parity",
        "Ecco fatto."
       ]
      }
     }
    }
   ]
  },
  {
   "id": "streamed",
   "title": "Streamed reply: thinking, prose, a tool run, prose",
   "slice": "messages.show-everything",
   "setup": {
    "aria": "main",
    "seed": []
   },
   "steps": [
    {
     "id": "attended",
     "do": {
      "attend": "main"
     },
     "expect": {
      "turns": []
     }
    },
    {
     "id": "streaming",
     "do": {
      "send": "think and run it",
      "then": {
       "wait": "running"
      }
     },
     "expect": {
      "running": true
     }
    },
    {
     "id": "settled",
     "do": {
      "wait": "idle"
     },
     "expect": {
      "running": false,
      "turns": [
       {
        "turn": 1,
        "inquiry": "think and run it",
        "nodes": [
         {
          "type": "thinking",
          "role": "output",
          "text_contains": "check the directory",
          "open": true
         },
         {
          "type": "prose",
          "role": "output",
          "text_contains": "Looking now."
         },
         {
          "type": "tool",
          "role": "output",
          "name": "bash",
          "status": "ok",
          "output_contains": "parity-ok",
          "open": true
         },
         {
          "type": "prose",
          "role": "output",
          "text_contains": "Done: parity-ok seen."
         }
        ]
       }
      ],
      "glyphs_on_screen": [
       "tool.ok"
      ],
      "screen": {
       "contains": [
        "I should check the directory first.",
        "Looking now.",
        "parity-ok",
        "Done: parity-ok seen."
       ]
      }
     }
    }
   ]
  },
  {
   "id": "steering",
   "title": "Steer a turn that is mid tool run",
   "slice": "messages.show-everything",
   "setup": {
    "aria": "main",
    "seed": []
   },
   "steps": [
    {
     "id": "attended",
     "do": {
      "attend": "main"
     },
     "expect": {
      "turns": []
     }
    },
    {
     "id": "working",
     "do": {
      "send": "steered work please",
      "then": {
       "wait": "running",
       "sleep": 1.5
      }
     },
     "expect": {
      "running": true
     }
    },
    {
     "id": "steered",
     "do": {
      "send": "steer ack now"
     },
     "expect": {
      "running": true
     }
    },
    {
     "id": "settled",
     "do": {
      "wait": "idle",
      "timeout": 30
     },
     "expect": {
      "running": false,
      "turns": [
       {
        "turn": 1,
        "inquiry": "steered work please",
        "nodes": [
         {
          "type": "prose",
          "role": "output",
          "text_contains": "Starting the long step."
         },
         {
          "type": "tool",
          "role": "output",
          "name": "bash",
          "status": "ok",
          "output_contains": "woke"
         },
         {
          "type": "steering",
          "role": "input",
          "text_contains": "steer ack now"
         },
         {
          "type": "prose",
          "role": "output",
          "text_contains": "Steer acknowledged."
         }
        ]
       }
      ],
      "glyphs_on_screen": [
       "steering"
      ],
      "web_gaps": [
       {
        "glyph": "steering",
        "note": "web labels the node 'Steered by', no arrow glyph"
       }
      ]
     }
    }
   ]
  },
  {
