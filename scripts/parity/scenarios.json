       "edges": [
        [
         "main",
         "branch"
        ]
       ]
      }
     }
    },
    {
     "id": "branch-attended",
     "do": {
      "attend": "branch"
     },
     "expect": {
      "turns": [
       {
        "turn": 1,
        "inquiry": "first question",
        "nodes": [
         {
          "type": "prose",
          "role": "output",
          "text_contains": "Ecco fatto."
         }
        ]
       }
      ],
      "tree": {
       "edges": [
        [
         "main",
         "branch"
        ]
       ]
      }
     }
    }
   ]
  },
  {
   "id": "delta",
   "title": "A turn that carries a form delta",
   "slice": "deltas.rows",
   "setup": {
    "aria": "main",
    "seed": [
     "before the change"
    ]
   },
   "steps": [
    {
     "id": "attended",
     "do": {
      "attend": "main"
     },
     "expect": {
      "turns": [
       {
        "turn": 1,
        "inquiry": "before the change",
        "nodes": [
         {
          "type": "prose",
          "role": "output",
          "text_contains": "Ecco fatto."
         }
        ]
       }
      ]
     }
    },
    {
     "id": "changed",
     "do": {
      "set": {
       "key": "stage",
       "value": "two"
      }
     },
     "expect": {
      "state": {
       "stage": "two"
      }
     }
    },
    {
     "id": "asked",
     "do": {
      "send": "after the change",
      "then": {
       "wait": "idle"
      }
     },
     "expect": {
      "running": false,
      "turns": [
       {
        "turn": 1,
        "inquiry": "before the change",
        "nodes": [
         {
          "type": "prose",
          "role": "output",
          "text_contains": "Ecco fatto."
         }
        ]
       },
       {
        "turn": 2,
        "inquiry": "after the change",
        "nodes": [
         {
          "type": "prose",
          "role": "output",
          "text_contains": "Ecco fatto."
         }
        ],
        "deltas": [
         {
          "key": "stage",
          "old": null,
          "new": "two",
          "header_glyph": "delta"
         }
        ]
       }
      ]
     }
    }
   ]
  },
