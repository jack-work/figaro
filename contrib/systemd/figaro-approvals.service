[Unit]
Description=figaro owner approvals page (acts as the owner)
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
ExecStart=%h/.local/share/figaro-approvals/figaro/bin/figaro approvals serve --listen gluck.tail34d120.ts.net:7482 --peer 100.103.40.20 --forms @96447061 --admin admin --origin https://approvals.kelliher.info
LoadCredential=edge:%h/.config/figaro-approvals/edge-token
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=%h/.local/state/figaro-approvals %t
LockPersonality=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=default.target
